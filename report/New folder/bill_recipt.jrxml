	<subDataset name="paycode_list" uuid="48b38e22-87ad-4307-adfc-706b90ee8689">
		<parameter name="ref_reciept" class="java.lang.String"/>
		<parameter name="type_query" class="java.lang.String" isForPrompting="false"/>
		<queryString>
			<![CDATA[SELECT
     cafe_paycode_settlement.`paycode_rate` AS paycode_rate,
     cafe_paycode_settlement.`paycode_amt` AS paycode_amt,
     cafe_paycode_settlement.`paid_amt` AS paid_amt,
     cafe_paycode_settlement.`paycode_name` AS paycode_name
FROM `cafe_paycode_settlement` $P{type_query}
where cafe_paycode_settlement.ref_receipt_num=$P{ref_reciept}]]>
		</queryString>
		<field name="paycode_rate" class="java.lang.Double">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="paycode_amt" class="java.lang.Double">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="paid_amt" class="java.lang.Double">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="paycode_name" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
	</subDataset>
	<parameter name="reciept" class="java.lang.String"/>
	<parameter name="Type_query" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT cafe_store.store_name,cafe_store.addr1,cafe_store.addr2,cafe_store.city,cafe_store.country,cafe_store.ph,cafe_store.trn,
cafe_pos_settlement_cash.receipt_no,cafe_pos_settlement_cash.reg_num,cafe_pos_settlement_cash.created_date as date,cafe_pos_settlement_cash.time,cafe_pos_settlement_cash.user,cafe_pos_settlement_cash.store_id,
cafe_pos_settlement_cash.cust_name,cafe_customer_master.addr1 as cust_addr,cafe_pos_settlement_cash.created_date as date, CAFE_CUSTOMER_MASTER.ADDR1 AS CUST_ADDR,cafe_pos_settlement_cash_items.qty as item_qty, cafe_pos_settlement_cash_items.total as item_ttl,cafe_pos_settlement_cash_items.vat as itm_vat,cafe_pos_settlement_cash.total as total_price,cafe_pos_settlement_cash_items.qty,cafe_pos_settlement_cash_items.unit_price,cafe_pos_settlement_cash_items.item_desc,cafe_pos_settlement_cash_items.item_code,cafe_pos_settlement_cash.type FROM cafe_store
inner join cafe_pos_settlement_cash on cafe_pos_settlement_cash.store_id=cafe_store.store_id
inner join cafe_pos_settlement_cash_items on cafe_pos_settlement_cash.receipt_no=cafe_pos_settlement_cash_items.ref_receipt_num
INNER JOIN CAFE_CUSTOMER_MASTER ON CAFE_CUSTOMER_MASTER.cust_name=cafe_pos_settlement_cash.cust_name
WHERE cafe_pos_settlement_cash.receipt_no='19000010']]>
	</queryString>
