	<queryString>
		<![CDATA[SELECT *,cafe_pos_settlement_cash.created_date as date, CAFE_CUSTOMER_MASTER.ADDR1 AS CUST_ADDR,cafe_pos_settlement_cash_items.qty as item_qty, cafe_pos_settlement_cash_items.total as item_ttl,cafe_pos_settlement_cash_items.vat as itm_vat,cafe_pos_settlement_cash.total as total_price FROM cafe_store inner join cafe_pos_settlement_cash inner join cafe_pos_settlement_cash_items INNER JOIN CAFE_CUSTOMER_MASTER WHERE CAFE_CUSTOMER_MASTER.cust_name=cafe_pos_settlement_cash.cust_name]]>
