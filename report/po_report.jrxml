	<subDataset name="po_details" uuid="abdc490e-1d8e-49e2-8b02-29e8059881d2">
		<parameter name="ref_po" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{ref_po}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT
     cafe_purchase_order.`barcode`,
     cafe_purchase_order.`item_code`,
     cafe_item_master.`item_name`,
     cafe_purchase_order.`qty`,
     cafe_purchase_order.`unit`,
     cafe_purchase_order.`cf`,
     cafe_purchase_order.`unit_cost`,
     cafe_purchase_order.`itm_disc`,
     cafe_purchase_order.`sub_cost_after_sub_ttl_disc`,
     cafe_purchase_order.`tax_val`,
     cafe_purchase_order.`total`
FROM
     `cafe_purchase_order` cafe_purchase_order INNER JOIN `cafe_item_master` cafe_item_master ON cafe_purchase_order.`item_code` = cafe_item_master.`item_code`
where cafe_purchase_order.ref_po_num=$P{ref_po}]]>
		</queryString>
