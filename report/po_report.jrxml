		<field name="itm_disc" class="java.lang.Double">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="sub_cost_after_sub_ttl_disc" class="java.lang.Double">
			<fieldDescription><![CDATA[]]></fieldDescription>
