	<queryString>
		<![CDATA[select cafe_store.store_name,cafe_store.addr1,cafe_store.addr2,cafe_store.city,cafe_store.country,cafe_store.ph,cafe_store.trn,config_db.company.image,cafe_purchase_list.po_no,cafe_purchase_list.po_date,cafe_store.store_id,cafe_purchase_list.vendor_id,cafe_vendor.vendor_name,cafe_purchase_list.invo_nu,cafe_purchase_list.ttl_price,cafe_purchase_list.total_vat ,cafe_purchase_list.grand_total,cafe_purchase_list.grand_disc,cafe_purchase_list.ttl_items from cafe_store inner join config_db.company on config_db.company.company_name=cafe_store.store_name inner join cafe_purchase_list on cafe_purchase_list.store_name=cafe_store.store_id inner join cafe_vendor on cafe_purchase_list.vendor_id=cafe_vendor.vendor_code]]>
	</queryString>
